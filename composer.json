{
    "name": "rgiskard7/fiction-planet-web",
    "description": "Red social educativa con PHP MVC + jQuery — proyecto de portafolio",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "classmap": [
            "controllers/",
            "models/",
            "models/dao/",
            "libs/",
            "libs/core/",
            "libs/validators/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    }
}
