{
    "name": "rgiskard7/fiction-planet-web",
    "description": "Red social educativa con PHP MVC + jQuery — proyecto de portafolio",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Controllers\\": "controllers/",
            "Models\\": "models/",
            "Models\\Dao\\": "models/dao/",
            "Libs\\": "libs/",
            "Libs\\Core\\": "libs/core/",
            "Libs\\Validators\\": "libs/validators/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    }
}
